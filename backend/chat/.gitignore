# ==========================================
# 1. PYTHON / DJANGO BACKEND
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Django local settings & secrets
db.sqlite3
db.sqlite3-journal
.env
*.env
.env.local

# Django collected static files and user media uploads
/static/
/media/
/staticfiles/

# Logs
*.log
logs/

# Virtual Environments
venv/
.venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# Testing & Coverage
.topo/
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# ==========================================
# 2. FRONTEND (Node / React / Next.js / Vue)
# ==========================================

# Dependency directories
node_modules/
jspm_packages/

# Production build outputs
/dist/
/build/
/out/
/.next/

# Frontend log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend environment variables
.env.development.local
.env.test.local
.env.production.local
.env.local

# Frontend testing
/coverage/

# Nuget/Svelte/Next cache
.nuxt/
.svelte-kit/

